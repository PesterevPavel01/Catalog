@* Components/EventTable.razor *@
@using Catalog.Contracts.Models
@typeparam TEvent where TEvent : OrderEventModel

<div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
    <table class="table table-hover">
        <thead class="sticky-top bg-white">
            <tr>
                <th>Время</th>
                <th>Тип события</th>
                <th>Код заказа</th>
                <th>Детали</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var evt in Events)
            {
                <tr class="@GetRowClass(evt) @(evt == LastEvent ? "new-event" : "")">
                    <td>
                        <small>@evt.OccurredAt.ToLocalTime().ToString("HH:mm:ss")</small>
                        <br />
                        <small class="text-muted">@evt.OccurredAt.ToLocalTime().ToString("dd.MM.yyyy")</small>
                    </td>
                    <td>
                        <span class="badge bg-@GetBadgeClass(evt) p-2">
                            @GetEventIcon(evt) @evt.EventType
                        </span>
                    </td>
                    <td>
                        <strong>@evt.OrderCode</strong>
                    </td>
                    <td>@evt.Details</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired]
    public required IEnumerable<TEvent> Events { get; set; }

    [Parameter]
    public TEvent? LastEvent { get; set; }

    [Parameter]
    public Func<TEvent, string>? GetRowClass { get; set; }

    [Parameter]
    public Func<TEvent, string>? GetBadgeClass { get; set; }

    [Parameter]
    public Func<TEvent, string>? GetEventIcon { get; set; }
}