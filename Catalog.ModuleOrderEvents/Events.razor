@page "/Events"
@rendermode InteractiveServer

@using Catalog.Contracts.Interfaces
@using Catalog.Contracts.Models
@using Catalog.ModuleOrderEvents.Interfaces
@using Catalog.ModuleOrderEvents.ViewModels
@using Microsoft.Extensions.Logging
@inject IEventsViewModel ViewModel
@inject ILogger<Events> Logger
@inject IEventStoreService EventStore

<PageTitle>События заказов</PageTitle>

<div class="container mt-4">
    
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Последние события заказов</h1>
        <div>
            <span class="badge bg-primary me-2">Событий: @(ViewModel.Events?.Count ?? 0)</span>
            <span class="badge @(ViewModel.IsConnected ? "bg-success" : "bg-danger")">
                @(ViewModel.IsConnected ? "🟢 Онлайн" : "🔴 Офлайн")
            </span>
        </div>
    </div>

    @if (ViewModel.Events == null)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Загрузка...</span>
            </div>
            <p class="mt-2">Загрузка событий...</p>
        </div>
    }
    else if (!ViewModel.Events.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Нет событий для отображения
        </div>
    }
    else
    {
        <div class="alert alert-success">
            <h4>Найдено событий: @ViewModel.Events.Count</h4>
            @foreach (var evt in ViewModel.Events)
            {
                <div>@evt.OrderCode - @evt.Details</div>
            }
        </div>
    }

    <div class="row mt-4">
        <div class="col-12">
            <button class="btn btn-primary" @onclick="TestAddEvent">
                🧪 Тест: добавить событие
            </button>
        </div>
    </div>

</div>

@code{
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        // Подписываемся на изменения ViewModel
        ViewModel.StateChanged += OnStateChanged;

        // Загружаем события
        await ViewModel.LoadEventsAsync();
    }

    private async void OnStateChanged()
    {
        if (_disposed) return;
        await InvokeAsync(StateHasChanged);
    }

    private async Task TestAddEvent()
    {
        Logger.LogWarning("🧸 ===== ТЕСТОВАЯ КНОПКА НАЖАТА =====");

        try
        {
            var testEvent = new OrderEventModel
            {
                Id = Guid.NewGuid().ToString(),
                OrderCode = $"TEST-{DateTime.Now:HHmmss}",
                EventType = "Test",
                Details = $"Тестовое событие создано в {DateTime.Now:HH:mm:ss}",
                OccurredAt = DateTime.UtcNow
            };

            Logger.LogWarning("📦 Создано тестовое событие: {Code}", testEvent.OrderCode);
            Logger.LogWarning("📦 EventStore Service is null? {IsNull}", EventStore == null);

            EventStore.AddEvent(testEvent);

            Logger.LogWarning("✅ Тестовое событие добавлено в EventStore");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ Ошибка в TestAddEvent");
        }
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        ViewModel.StateChanged -= OnStateChanged;
        ViewModel.Dispose();
    }
}