{
    "ConnectionStrings": {
        "AppDbConnectionString": "server=localhost;port=3366;database=catalog;User=root;Password=Pesterev1234!;"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "RabbitMq": {
        "RabbitUrl": "amqp://catalog_rebus:Pesterev1234!@localhost:5672/catalog_rebus"
    },
    "Authorization": {
        "Issuer": "https://localhost:44390",
        "Audience": "https://localhost:44390",
        "SecretKey": "this_is_secret_key_for_jwt_token_generation_(catalog)",
        "Authority": "Authority",
        "LifetimeInMinutes": 15,
        "RefreshTokenValidityInDays": 7
    },
    "AllowedHosts": "*",
    "ApplicationConfiguration": {
        //TextProperty ["Contains"]
        //NumericProperty ["=", "!=",">","<",Contains]
        //Если < то Толщина должна быть < Минимальной толщины
        "ComponentCompatibilityRules": [
            {
                "ComponentParameter": "Минимальная толщина",
                "Dependencies": [
                    {
                        "TargetComponentTypes": [
                            "Плита"
                        ], // не задано, значит распространяется на все типы компонентов
                        "Parameter": "Толщина",
                        "ComparisonRule": ">"
                    }
                ]
            },
            {
                "ComponentParameter": "Конфликтующий цвет",
                "Dependencies": [
                    {
                        "TargetComponentTypes": [
                            "Пленка"
                        ],
                        "Parameter": "Цвет",
                        "ComparisonRule": "NoContains"
                    }
                ]
            },
            {
                //можно указать, что конфликтует со всеми видами торцов, кроме "без торца"
                "ComponentParameter": "Торец",
                "Dependencies": [
                    {
                        "TargetComponentTypes": [
                            "Торец"
                        ],
                        "Parameter": "Вид",
                        "ComparisonRule": "Contains"
                    }
                ]
            }
        ],
        "ModuleRequiredParameters": [
            {
                "ModuleTypeCode": "00000000FSD",
                "Parameters": [
                    {
                        "Parameter": "Ширина",
                        "Dependencies": null
                    },
                    {
                        "Parameter": "Высота",
                        "Dependencies": null
                    }
                ]
            }
        ],
        "ModuleTechnologicalRestrictions": [
            {
                "ModuleTypeCode": "00000000FSD",
                "Parameter": "Ширина",
                "Value": 1150,
                "ComparisonRule": "<"
                //только Свойство ШИРИНА должно быть меньше чем Value
            },
            {
                "ModuleTypeCode": "00000000FSD",
                "Parameter": "Высота",
                "Value": 2750,
                "ComparisonRule": "<"
            },
            {
                "ModuleTypeCode": "00000000FSD",
                "Parameter": "Высота",
                "Value": 300,
                "ComparisonRule": ">"
            },
            {
                "ModuleTypeCode": "00000000FSD",
                "Parameter": "Ширина",
                "Value": 40,
                "ComparisonRule": ">"
            }
        ],
        "ModuleCompositionRules": [
            {
                "ModuleParameter": "Ширина",
                "Dependencies": [
                    {
                        "TargetComponentTypes": null, // не задано, значит распространяется на все типы компонентов
                        "Parameter": "Минимальная ширина",
                        "ComparisonRule": "<" //условие для существующего элемента: Существующий "ComparisonRule" Новый
                    },
                    {
                        "TargetComponentTypes": null,
                        "Parameter": "Максимальная ширина",
                        "ComparisonRule": ">"
                    }
                ]
            },
            {
                "ModuleParameter": "Высота",
                "Dependencies": [
                    {
                        "TargetComponentTypes": null, // не задано, значит распространяется на все типы компонентов
                        "Parameter": "Минимальная высота",
                        "ComparisonRule": "<" //условие для существующего элемента: Существующий "ComparisonRule" Новый
                    },
                    {
                        "TargetComponentTypes": null,
                        "Parameter": "Максимальная высота",
                        "ComparisonRule": ">"
                    }
                ]
            }
        ]
    }
}