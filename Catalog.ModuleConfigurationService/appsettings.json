{
    "ConnectionStrings": {
        "AppDbConnectionString": "server=catalog-mysql;port=3306;database=catalog;User=manufacture;Password=manufacture;"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "/app/logs/log-.txt",
                    "rollOnFileSizeLimit": true,
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} Path: {RequestPath}; Id: {RequestId}; {Message:lj}{Exception}{NewLine}{NewLine}",
                    "rollingInterval": "Day"
                }
            }
        ],
        "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ]
    },
    "RabbitMq": {
        "RabbitUrl": "amqp://catalog_rebus:Pesterev1234!@catalog-rabbitmq:5672/catalog_rebus"
    },
    "Authorization": {
        "Issuer": "https://localhost:8092",
        "Audience": "https://localhost:8092",
        "SecretKey": "this_is_secret_key_for_jwt_token_generation_(catalog)",
        "Authority": "Authority",
        "LifetimeInMinutes": 15,
        "RefreshTokenValidityInDays": 7,
        "AdministratorPassword": "Qwerty1234!"
    },
    "AllowedHosts": "*",
    "TelegramBot": {
        "Token": "7562655253:AAEKJQnd1YXSXpEXtQJ0NvJSo3C1B-GEN8E",
        "ChatId": "-1002463757906"
    },
    "ApplicationConfiguration": {
        "AllowModifyModuleWithCompletedOrders": false,
        //TextProperty ["Contains"]
        //NumericProperty ["=", "!=",">","<",Contains]
        //Если < то Толщина должна быть < Минимальной толщины
        "ComponentCompatibilityRules": [
            {
                "ComponentParameter": "Минимальная толщина",
                "Dependencies": [
                    {
                        "TargetComponentTypes": [
                            "Плита"
                        ], // не задано, значит распространяется на все типы компонентов
                        "Parameter": "Толщина",
                        "ComparisonRule": ">"
                    }
                ]
            },
            {
                "ComponentParameter": "Конфликтующий цвет",
                "Dependencies": [
                    {
                        "TargetComponentTypes": [
                            "Пленка"
                        ],
                        "Parameter": "Цвет",
                        "ComparisonRule": "NoContains"
                    }
                ]
            },
            {
                //можно указать, что конфликтует со всеми видами торцов, кроме "без торца"
                "ComponentParameter": "Торец",
                "Dependencies": [
                    {
                        "TargetComponentTypes": [
                            "Торец"
                        ],
                        "Parameter": "Вид",
                        "ComparisonRule": "Contains"
                    }
                ]
            }
        ],
        "ModuleRequiredParameters": [
            {
                "ModuleTypeCode": "00000000FSD",
                "Parameters": [
                    {
                        "Parameter": "Ширина",
                        "Dependencies": null
                    },
                    {
                        "Parameter": "Высота",
                        "Dependencies": null
                    }
                ]
            }
        ],
        "ModuleTechnologicalRestrictions": [
            {
                "ModuleTypeCode": "00000000FSD",
                "Parameter": "Ширина",
                "Value": 1150,
                "ComparisonRule": "<"
                //только Свойство ШИРИНА должно быть меньше чем Value
            },
            {
                "ModuleTypeCode": "00000000FSD",
                "Parameter": "Высота",
                "Value": 2750,
                "ComparisonRule": "<"
            },
            {
                "ModuleTypeCode": "00000000FSD",
                "Parameter": "Высота",
                "Value": 300,
                "ComparisonRule": ">"
            },
            {
                "ModuleTypeCode": "00000000FSD",
                "Parameter": "Ширина",
                "Value": 40,
                "ComparisonRule": ">"
            }
        ],
        "ModuleCompositionRules": [
            {
                "ModuleParameter": "Ширина",
                "Dependencies": [
                    {
                        "TargetComponentTypes": null, // не задано, значит распространяется на все типы компонентов
                        "Parameter": "Минимальная ширина",
                        "ComparisonRule": "<" //условие для существующего элемента: Существующий "ComparisonRule" Новый
                    },
                    {
                        "TargetComponentTypes": null,
                        "Parameter": "Максимальная ширина",
                        "ComparisonRule": ">"
                    }
                ]
            },
            {
                "ModuleParameter": "Высота",
                "Dependencies": [
                    {
                        "TargetComponentTypes": null, // не задано, значит распространяется на все типы компонентов
                        "Parameter": "Минимальная высота",
                        "ComparisonRule": "<" //условие для существующего элемента: Существующий "ComparisonRule" Новый
                    },
                    {
                        "TargetComponentTypes": null,
                        "Parameter": "Максимальная высота",
                        "ComparisonRule": ">"
                    }
                ]
            }
        ]
    }
}